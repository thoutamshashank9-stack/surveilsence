# ============================================
# Environment Variables Template
# ============================================

# Application
APP_NAME=edge-ai-cctv
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/events.db

# Config
CONFIG_PATH=../config/development.yaml

# Inference
INFERENCE_BACKEND=auto
MODEL_REGISTRY_PATH=../models/registry

# Notifications (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Redis (optional, for production event bus)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
