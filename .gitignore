env/
venv/
.venv/
ENV/

# ---------- Testing ----------
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Environment ----------
.env
.env.local
.env.production
.env.staging
*.env

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- Frontend Build ----------
frontend/dist/
frontend/build/
*.tsbuildinfo

# ---------- Database ----------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- Logs ----------
*.log
logs/

