data/
clips/
recordings/
uploads/
*.mp4
*.avi
*.mkv
*.mov
*.jpg
*.jpeg
*.png
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!docs/diagrams/**/*.png

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Misc ----------
*.bak
*.tmp
*.temp
pip-log.txt
pip-delete-this-directory.txt